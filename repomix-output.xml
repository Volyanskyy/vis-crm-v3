              Назад до каталогів
            </Link>
          </div>
        </div>

        <div className="mt-6 grid gap-3 md:grid-cols-3">
          <div className="rounded-2xl border border-neutral-200 bg-neutral-50 px-4 py-4">
            <div className="text-xs font-semibold uppercase tracking-[0.12em] text-neutral-500">
