/**
 * Path: src/app/projects/page.tsx
 *
 * Призначення:
 * Сторінка списку проєктів для VIS CRM V3.
 * Показує центральну операційну сутність системи:
 * клієнта, статус, адресу, менеджера та базові лічильники.
 */

import Link from "next/link";
import { prisma } from "@/lib/prisma";
import { ProjectFormModal } from "./project-form-modal";

function formatDate(date: Date | null) {
  if (!date) return "—";

  return new Intl.DateTimeFormat("uk-UA", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(date);
}

function formatDateForInput(date: Date | null) {
  if (!date) return "";

  return new Intl.DateTimeFormat("sv-SE").format(date);
}

function getStatusLabel(status: string) {
  switch (status) {
    case "DRAFT":
      return "Чернетка";
    case "ACTIVE":
      return "Активний";
    case "ON_HOLD":
      return "Пауза";
    case "COMPLETED":
      return "Завершений";
    case "CANCELLED":
      return "Скасований";
    case "ARCHIVED":
      return "Архівний";
    default:
      return status;
  }
}

function getStatusClasses(status: string) {
  switch (status) {
    case "ACTIVE":
      return "bg-emerald-100 text-emerald-700";
    case "ON_HOLD":
      return "bg-amber-100 text-amber-700";
    case "COMPLETED":
      return "bg-sky-100 text-sky-700";
    case "CANCELLED":
      return "bg-rose-100 text-rose-700";
    case "ARCHIVED":
      return "bg-neutral-200 text-neutral-700";
    case "DRAFT":
    default:
      return "bg-neutral-100 text-neutral-700";
  }
}

export default async function ProjectsPage() {
  const [projects, clients, managers] = await Promise.all([
    prisma.project.findMany({
      orderBy: [{ updatedAt: "desc" }],
      include: {
        client: {
          select: {
            id: true,
            name: true,
            companyName: true,
          },
        },
        manager: {
          select: {
            id: true,
            firstName: true,
            lastName: true,
            fullName: true,
          },
        },
        _count: {
          select: {
            teamMembers: true,
            estimates: true,
            fieldReports: true,
            rooms: true,
          },
        },
      },
    }),
    prisma.client.findMany({
      where: {
        isArchived: false,
      },
      orderBy: [{ name: "asc" }],
      select: {
        id: true,
        name: true,
        companyName: true,
      },
    }),
    prisma.user.findMany({
      where: {
        employeeProfile: {
          is: {
            isArchived: false,
          },
        },
      },
      orderBy: [{ lastName: "asc" }, { firstName: "asc" }],
      include: {
        employeeProfile: {
          select: {
            positionTitle: true,
          },
        },
      },
    }),
  ]);

  const totalProjects = projects.length;
  const activeProjects = projects.filter(
    (project) => project.status === "ACTIVE",
  ).length;
  const draftProjects = projects.filter(
    (project) => project.status === "DRAFT",
  ).length;
  const completedProjects = projects.filter(
    (project) => project.status === "COMPLETED",
  ).length;

  const managerOptions = managers.map((manager) => ({
    id: manager.id,
    fullName:
      manager.fullName ||
      `${manager.firstName} ${manager.lastName}`.trim(),
    positionTitle: manager.employeeProfile?.positionTitle ?? "",
  }));

  return (
    <div className="flex flex-col gap-8">
      <section className="rounded-3xl border border-neutral-200 bg-white p-6 shadow-sm sm:p-8">
        <div className="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div className="max-w-3xl">
            <p className="text-sm font-medium uppercase tracking-[0.12em] text-neutral-500">
