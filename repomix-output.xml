                  <label className="space-y-1.5">
                    <span className={labelClassName}>Підкатегорія</span>
                    <input
                      value={initialValue?.subcategory ?? ""}
                      disabled
                      className={`${inputClassName} bg-neutral-100 text-neutral-500`}
