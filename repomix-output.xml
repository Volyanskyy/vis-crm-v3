"use client";

import { useEffect, useState, useTransition } from "react";
import { createPortal } from "react-dom";
import { createRoomTypeAction, updateRoomTypeAction } from "./actions";

type RoomTypeFormValue = {
  id: string;
  code: string;
  name: string;
  description: string;
  isArchived: boolean;
};

const emptyValue: RoomTypeFormValue = {
  id: "",
  code: "",
  name: "",
  description: "",
  isArchived: false,
};

type Props = {
  mode: "create" | "edit";
  triggerLabel: string;
  triggerClassName?: string;
  initialValue?: Partial<RoomTypeFormValue>;
};

const inputClassName =
  "w-full rounded-xl border border-neutral-400 bg-white px-3.5 py-2.5 text-sm text-neutral-950 placeholder:text-neutral-500 outline-none transition focus:border-neutral-900 focus:ring-2 focus:ring-neutral-200";

const textareaClassName =
  "w-full min-h-[88px] resize-y rounded-xl border border-neutral-400 bg-white px-3.5 py-2.5 text-sm text-neutral-950 placeholder:text-neutral-500 outline-none transition focus:border-neutral-900 focus:ring-2 focus:ring-neutral-200";

const labelClassName =
  "text-sm font-semibold tracking-tight text-neutral-950";

export function RoomTypeFormModal({
  mode,
  triggerLabel,
  triggerClassName,
  initialValue,
}: Props) {
  const [open, setOpen] = useState(false);
  const [mounted, setMounted] = useState(false);
  const [isPending, startTransition] = useTransition();
  const [error, setError] = useState<string | null>(null);

  const value: RoomTypeFormValue = {
    ...emptyValue,
    ...initialValue,
  };

  useEffect(() => {
    setMounted(true);
  }, []);

  useEffect(() => {
    if (!open) {
      setError(null);
    }
  }, [open]);

  function onSubmit(formData: FormData) {
    setError(null);

    startTransition(async () => {
      try {
        if (mode === "create") {
          await createRoomTypeAction(formData);
        } else {
          await updateRoomTypeAction(formData);
        }

        setOpen(false);
      } catch (err) {
        setError(
          err instanceof Error ? err.message : "Не вдалося зберегти тип приміщення.",
        );
      }
    });
  }

  const modal = open ? (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/45 p-4">
      <div className="w-full max-w-2xl rounded-2xl border border-neutral-200 bg-white shadow-2xl">
        <div className="flex items-start justify-between gap-4 border-b border-neutral-200 px-6 py-4">
          <div>
            <p className="text-xs font-semibold uppercase tracking-[0.14em] text-neutral-500">
              {mode === "create" ? "Новий тип" : "Редагування типу"}
            </p>
            <h2 className="mt-1 text-2xl font-semibold tracking-tight text-neutral-950">
              {mode === "create" ? "Створити тип приміщення" : "Оновити тип приміщення"}
            </h2>
          </div>

          <button
            type="button"
            onClick={() => setOpen(false)}
            className="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-neutral-200 bg-white text-base text-neutral-500 transition hover:bg-neutral-50 hover:text-neutral-900"
            aria-label="Закрити модалку"
          >
            ✕
          </button>
        </div>

        <form action={onSubmit} className="px-6 py-4">
          <input type="hidden" name="id" defaultValue={value.id} />

          <div className="grid gap-3 sm:grid-cols-2">
            <label className="flex flex-col gap-1.5 sm:col-span-2">
              <span className={labelClassName}>Назва *</span>
              <input
                name="name"
                defaultValue={value.name}
                required
                className={inputClassName}
                placeholder="Спальня, Кухня, Коридор тощо"
              />
            </label>

            <label className="flex flex-col gap-1.5 sm:col-span-2">
              <span className={labelClassName}>Код</span>
              <input
                name="code"
                defaultValue={value.code}
                className={inputClassName}
                placeholder="Напр. BEDROOM"
              />
            </label>

            <label className="flex flex-col gap-1.5 sm:col-span-2">
              <span className={labelClassName}>Опис</span>
              <textarea
                name="description"
                defaultValue={value.description}
                rows={3}
                className={textareaClassName}
                placeholder="Деталі або примітки"
              />
            </label>

            {mode === "edit" ? (
              <label className="mt-2 flex items-center gap-2 sm:col-span-2">
                <input
                  type="checkbox"
                  name="isArchived"
                  defaultChecked={value.isArchived}
                  className="h-4 w-4 rounded border-neutral-400 accent-neutral-900"
                />
                <span className="text-sm font-medium text-neutral-700">
                  В архіві (не показувати при створенні нових кімнат)
                </span>
              </label>
            ) : null}
          </div>

          {error ? (
            <div className="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2.5 text-sm text-rose-700">
              {error}
            </div>
          ) : null}

          <div className="mt-5 flex flex-col-reverse gap-2.5 border-t border-neutral-200 pt-4 sm:flex-row sm:justify-end">
            <button
              type="button"
              onClick={() => setOpen(false)}
              className="inline-flex items-center justify-center rounded-xl border border-neutral-300 bg-white px-4 py-2.5 text-sm font-semibold text-neutral-900 transition hover:bg-neutral-50"
            >
              Скасувати
            </button>

            <button
              type="submit"
              disabled={isPending}
              className="inline-flex items-center justify-center rounded-xl bg-neutral-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-800 disabled:cursor-not-allowed disabled:opacity-60"
            >
              {isPending
                ? "Збереження..."
                : mode === "create"
                  ? "Створити тип"
                  : "Зберегти зміни"}
            </button>
          </div>
        </form>
      </div>
    </div>
  ) : null;

  return (
    <>
      <button
        type="button"
        onClick={() => setOpen(true)}
        className={
          triggerClassName ??
          "inline-flex items-center justify-center rounded-xl bg-neutral-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800"
        }
      >
        {triggerLabel}
      </button>

      {mounted && modal ? createPortal(modal, document.body) : null}
    </>
  );
}
</file>

<file path="src/app/references/skill-tags/actions.ts">
"use server";

import { revalidatePath } from "next/cache";
import { prisma } from "@/lib/prisma";

function clean(value: FormDataEntryValue | null) {
  const text = String(value ?? "").trim();
  return text.length > 0 ? text : null;
}

export async function createSkillTagAction(formData: FormData) {
  const code = clean(formData.get("code"));
  const name = clean(formData.get("name"));

  if (!code) {
    throw new Error("Код навички обовʼязковий.");
  }

  if (!name) {
    throw new Error("Назва навички обовʼязкова.");
  }

  const existingByCode = await prisma.skillTag.findUnique({
    where: { code },
    select: { id: true },
  });

  if (existingByCode) {
    throw new Error("Навичка з таким кодом уже існує.");
  }

  const existingByName = await prisma.skillTag.findFirst({
    where: { name },
    select: { id: true },
  });

  if (existingByName) {
    throw new Error("Навичка з такою назвою вже існує.");
  }

  await prisma.skillTag.create({
     data:{
      code,
      name,
      description: clean(formData.get("description")),
    },
  });

  revalidatePath("/references");
  revalidatePath("/references/skill-tags");
}

export async function updateSkillTagAction(formData: FormData) {
  const id = clean(formData.get("id"));
  const code = clean(formData.get("code"));
  const name = clean(formData.get("name"));

  if (!id) {
    throw new Error("Не передано id навички.");
  }

  if (!code) {
    throw new Error("Код навички обовʼязковий.");
  }

  if (!name) {
    throw new Error("Назва навички обовʼязкова.");
  }

  const current = await prisma.skillTag.findUnique({
    where: { id },
    select: { id: true, code: true, name: true },
  });

  if (!current) {
    throw new Error("Навичку не знайдено.");
  }

  if (current.code !== code) {
    const existingByCode = await prisma.skillTag.findUnique({
      where: { code },
      select: { id: true },
    });

    if (existingByCode) {
      throw new Error("Інша навичка з таким кодом уже існує.");
    }
  }

  if (current.name !== name) {
    const existingByName = await prisma.skillTag.findFirst({
      where: { name },
      select: { id: true },
    });

    if (existingByName) {
      throw new Error("Інша навичка з такою назвою вже існує.");
    }
  }

  await prisma.skillTag.update({
    where: { id },
     data:{
      code,
      name,
      description: clean(formData.get("description")),
    },
  });

  revalidatePath("/references");
  revalidatePath("/references/skill-tags");
}
