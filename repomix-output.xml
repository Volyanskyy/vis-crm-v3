  function getPointStatusClass(status: string) {
    switch (status) {
      case "ACTIVE":
        return "bg-emerald-100 text-emerald-700";
      case "ARCHIVED":
        return "bg-neutral-200 text-neutral-700";
      case "DRAFT":
