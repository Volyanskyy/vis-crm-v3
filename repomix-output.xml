<file path="prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum EstimateStatus {
  DRAFT
  INTERNAL
  SENT
  APPROVED
  REJECTED
  ARCHIVED
}

enum EstimateItemType {
  WORK
  MATERIAL
  CUSTOM
}

enum PriceSourceType {
  MANUAL
  WORK_PRICE_ITEM
  MATERIAL_ITEM
  IMPORTED
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FieldLogStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  ACCEPTED
  REJECTED
}

enum InventorySource {
  WAREHOUSE
  PURCHASED_FOR_PROJECT
  MANUAL
}

enum ReportPointStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AccessEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET
  PASSKEY_REGISTERED
  PASSKEY_REMOVED
  SESSION_REVOKED
}

enum AuditEntityType {
  TENANT
  USER
  CLIENT
  PROJECT
  ESTIMATE
  ESTIMATE_ITEM
  WORK_PRICE_LIST
  WORK_PRICE_ITEM
  MATERIAL_CATALOG
  MATERIAL_ITEM
  FIELD_REPORT
  WORK_LOG
  MATERIAL_LOG
  PANEL_LINE
  ROOM
  FITTING_POINT
  LIGHTING_POINT
  OTHER
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  STATUS_CHANGE
  EXPORT
  LOGIN
  OTHER
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  legalName String?
  phone     String?
  email     String?
  timezone  String?  @default("Europe/Kyiv")
  currency  String?  @default("UAH")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  clients             Client[]
  employees           EmployeeProfile[]
  projects            Project[]
  workPriceLists      WorkPriceList[]
  workPriceListScopes WorkPriceListScope[]
  materialCatalogs    MaterialCatalog[]
  roomTypes           RoomType[]
  fittingTypes        FittingType[]
  lightingSystemTypes LightingSystemType[]
  brands              Brand[]
  auditLogs           AuditLog[]
  accessLogs          AccessLog[]
  estimates           Estimate[]
  fieldReports        FieldReport[]
}

model User {
  id              String     @id @default(cuid())
  tenantId        String
  email           String
  phone           String?
  passwordHash    String?
  firstName       String
  lastName        String
  fullName        String?
  avatarUrl       String?
  status          UserStatus @default(INVITED)
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile?
  userRoles       UserRole[]
  sessions        Session[]
  accounts        Account[]
  authenticators  Authenticator[]

  createdProjects Project[]     @relation("ProjectCreatedBy")
  managedProjects Project[]     @relation("ProjectManager")
  projectTeams    ProjectTeam[]

  createdEstimates  Estimate[] @relation("EstimateCreatedBy")
  approvedEstimates Estimate[] @relation("EstimateApprovedBy")

  fieldReports    FieldReport[] @relation("FieldReportAuthor")
  reviewedReports FieldReport[] @relation("FieldReportReviewer")

  auditLogs  AuditLog[]
  accessLogs AccessLog[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, lastName, firstName])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
